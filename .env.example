# Discord Bot Configuration
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-oauth-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
BOT_OWNER_IDS=your-discord-user-id-here

# Supabase Configuration
# Get your credentials from: https://app.supabase.com
# 1. Go to your project settings
# 2. Copy API URL and API Key (use "anon" key for client-side)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Dashboard Configuration
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-generate-random-string-here