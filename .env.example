# Discord Bot Configuration
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-oauth-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
BOT_OWNER_IDS=your-discord-user-id-here

# MongoDB Atlas Connection String
# Get free tier at: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/automod-pro?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/automod-pro?retryWrites=true&w=majority

# Redis Cloud Connection String
# Get free tier at: https://redis.com/try-free/
# Format: rediss://default:password@endpoint:port
REDIS_URL=rediss://default:your-redis-password@your-redis-endpoint:6379

# Dashboard Configuration
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-generate-random-string-here